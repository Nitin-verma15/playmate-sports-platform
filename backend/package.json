{
  "name": "playmate-backend",
  "version": "1.0.0",
  "description": "Backend API for PlayMate",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec \"tsc && node dist/server.js\"",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "private": true,
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "18.0.4",
    "express": "5.2.1",
    "firebase-admin": "14.5.0",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "nodemon": "3.1.14",
    "ts-node": "10.9.2",
    "typescript": "7.0.2"
  }
}
